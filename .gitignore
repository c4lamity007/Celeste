# Release payloads/metadata are regenerated by tools/package_*.
# Public native-verifier/launcher-channel.json and src/release.rs remain tracked.
/auth-service/releases/*
!/auth-service/releases/.gitkeep
/package-loader-chain-output.json
/native-verifier/assets/hook-build/
/tools/hardware-dump/

